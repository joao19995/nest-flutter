<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug-only network policy.

  The local dev API is served over plain HTTP (e.g. http://10.0.2.2:3000 for
  the Android emulator, or a LAN IP for a physical device), and Android blocks
  cleartext traffic by default. This file is part of the `debug` source set,
  so release builds keep the platform default (HTTPS only).
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
